{
  "name": "bms-data-platform-desktop-monitor",
  "version": "0.7.32",
  "description": "Read-only desktop monitor for the BMS Data Platform phone gateway",
  "author": "zayants",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "package:win": "pnpm build && powershell -ExecutionPolicy Bypass -File tools/package-portable.ps1"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "6.0.2",
    "lucide-react": "0.468.0",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "vite": "8.0.13",
    "write-excel-file": "4.1.1"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "electron": "43.4.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
